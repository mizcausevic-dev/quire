# Canonical origin used in metadata, sitemap, and JSON-LD.
QUIRE_CANONICAL_ORIGIN=http://localhost:3000

# SQLite file. Use a persistent disk in production.
QUIRE_DB_PATH=data/quire.sqlite

# Fictional seed data stays out of search indexes unless this is exactly "0".
# Set 0 only after real, reviewed listings replace the demonstration catalog.
QUIRE_DEMO_NOINDEX=1

# Leave empty for mock billing. A non-empty secret switches to signed webhooks
# and disables mock confirmation. Never treat a browser redirect as payment.
BILLING_WEBHOOK_SECRET=

# Set to 1 only for a deliberate local database reset.
QUIRE_ALLOW_RESET=0
